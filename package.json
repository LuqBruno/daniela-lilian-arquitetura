{
  "name": "daniela-lilian-previa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3036 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "verificar-dist": "node scripts/verificar-dist.mjs",
    "check": "npm run typecheck && npm run build && npm run verificar-dist",
    "preview": "vite preview --host 127.0.0.1 --port 3036 --strictPort"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
